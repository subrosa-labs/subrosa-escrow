# SubRosa relayer configuration.
#
# Copy to `.env` and fill it in. Nothing loads it for you: either export it into your
# shell (`set -a; . ./.env; set +a`) or run Node with `--env-file`:
#
#   node --env-file=.env --experimental-transform-types src/index.ts

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
PORT=8080
HOST=0.0.0.0
# Comma-separated browser origins, or * for any.
CORS_ORIGINS=http://localhost:3000

# --- Stellar network ------------------------------------------------------
STELLAR_NETWORK=testnet
# Override only for a private/self-hosted RPC.
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# --- Deployed contract ----------------------------------------------------
# `make -C contracts deploy-testnet` prints this and writes it to FUNDING.json.
SUBROSA_CONTRACT_ID=
# Only used for display metadata; the contract is the source of truth.
SUBROSA_SETTLEMENT_TOKEN=

# --- Relayer keys ---------------------------------------------------------
# Stellar ed25519 secret keys (S...), comma separated.
#
# A single operator should hold ONE key. The contract accepts an M-of-N quorum over
# independent operators, and co-locating several keys collapses that quorum into a
# single point of trust — which is the whole thing the quorum exists to avoid. The
# unique-key rule below is enforced only for single-process local testing.
RELAYER_SECRET_KEYS=
# Optional: the matching public keys, so startup can warn when a configured key is not
# in the on-chain set instead of failing later with AttestationInvalid.
RELAYER_PUBLIC_KEYS=

# --- drand ----------------------------------------------------------------
# quicknet. Do not change without redeploying the contract: the chain hash is pinned
# in Config at initialise time, and a mismatch makes every attestation invalid.
DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
DRAND_CHAIN_URL=https://api.drand.sh/52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971

# --- Persistence ----------------------------------------------------------
# Omit to use the in-memory store (fine for development and tests; sealed envelopes
# are lost on restart, which degrades reveal availability but never correctness).
DATABASE_URL=

# --- Workers --------------------------------------------------------------
INDEXER_ENABLED=true
WORKER_ENABLED=true
WORKER_INTERVAL_MS=5000
JOB_LEASE_MS=120000
JOB_MAX_ATTEMPTS=8

# --- Limits ---------------------------------------------------------------
MAX_ENVELOPES_PER_AUCTION=64
MAX_ENVELOPE_BYTES=8192

# --- Transaction submission ----------------------------------------------
TX_RETRIES=4
TX_RETRY_BASE_MS=1500

# --- Admin ----------------------------------------------------------------
# When set, enables POST /v1/admin/*, guarded by `Authorization: Bearer <token>`.
# Leave unset in any public deployment: those routes can trigger settlement sweeps.
ADMIN_TOKEN=
