# SubRosa relayer configuration.
#
# Copy to `.env` and fill it in. Nothing loads it for you: either export it into
# your shell (`set -a; . ./.env; set +a`) or run Node with `--env-file`:
#
#   node --env-file=.env --experimental-transform-types src/index.ts
#
# Every variable below is read by src/config.ts. Values shown are the defaults.
# "Required" means startup fails without a real value (the config schema or the
# composition root rejects it); "optional" means the default is safe.

# --- Runtime ---------------------------------------------------------------
# development | test | production. Required in effect on mainnet: production also
# enforces one relayer key per process.
NODE_ENV=development

# trace | debug | info | warn | error | fatal. Optional, default info.
LOG_LEVEL=info

# HTTP port. Optional, default 8080.
PORT=8080

# Bind address. Optional, default 0.0.0.0.
HOST=0.0.0.0

# Comma-separated browser origins allowed by CORS, or * for any. Optional, but the
# code default is * — set exact origins for anything public.
CORS_ORIGINS=http://localhost:3000

# --- Stellar network ------------------------------------------------------
# testnet | futurenet | mainnet | standalone. Optional, default testnet.
STELLAR_NETWORK=testnet

# Optional. Override only for a private/self-hosted RPC. Defaults to the public
# endpoint for STELLAR_NETWORK.
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# --- Deployed contract ----------------------------------------------------
# Strkey C... id of the deployed subrosa_escrow contract. REQUIRED: the relayer
# refuses to boot without it. `make -C contracts deploy-testnet` prints it.
SUBROSA_CONTRACT_ID=

# Optional. SAC address of the escrow asset, used only for display metadata; the
# contract is the source of truth.
SUBROSA_SETTLEMENT_TOKEN=

# --- Relayer keys ---------------------------------------------------------
# Stellar ed25519 secret keys (S...), comma separated. REQUIRED while
# WORKER_ENABLED is true (the default); set WORKER_ENABLED=false for read-only.
#
# A single operator should hold ONE key. The contract accepts an M-of-N quorum over
# independent operators, and co-locating several keys collapses that quorum into a
# single point of trust. Production startup rejects more than one key per process.
RELAYER_SECRET_KEYS=

# Optional. Matching public keys (G...), so startup can warn when a configured key
# is not in the on-chain set instead of failing later with AttestationInvalid.
RELAYER_PUBLIC_KEYS=

# --- drand ----------------------------------------------------------------
# quicknet chain hash. Optional, default quicknet. Do not change without
# redeploying the contract: it is pinned in Config at initialise time and a
# mismatch makes every attestation invalid.
DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971

# Optional. Defaults to the quicknet API endpoint for the hash above.
DRAND_CHAIN_URL=https://api.drand.sh/52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971

# --- Persistence ----------------------------------------------------------
# Postgres connection string. Optional: unset uses the in-memory store, which is
# fine for development and tests. Sealed envelopes are lost on restart, which
# degrades reveal availability but never correctness.
DATABASE_URL=

# --- Workers --------------------------------------------------------------
# Index live auctions into the read cache. Optional, default true; requires
# SUBROSA_CONTRACT_ID (or set false).
INDEXER_ENABLED=true

# Run the observe/attest/reveal/settle loop in this process. Optional, default
# true; requires RELAYER_SECRET_KEYS (or set false for an API-only instance).
WORKER_ENABLED=true

# Worker tick interval, milliseconds. Optional, default 5000, minimum 500.
WORKER_INTERVAL_MS=5000

# How long a claimed job stays invisible to other workers, milliseconds. Optional,
# default 120000, minimum 10000.
JOB_LEASE_MS=120000

# Attempts before a job is parked as failed. Optional, default 8, minimum 1.
JOB_MAX_ATTEMPTS=8

# --- Limits ---------------------------------------------------------------
# Envelopes accepted per auction; mirrors the contract's max_bids. Optional,
# default 64, minimum 1.
MAX_ENVELOPES_PER_AUCTION=64

# Maximum accepted envelope size, bytes. Optional, default 8192, minimum 256.
MAX_ENVELOPE_BYTES=8192

# --- Transaction submission ----------------------------------------------
# Retries on transient RPC failures. Optional, default 4, minimum 0.
TX_RETRIES=4

# Base backoff between retries, milliseconds. Optional, default 1500, minimum 100.
TX_RETRY_BASE_MS=1500

# --- Admin ----------------------------------------------------------------
# Bearer token for POST /v1/admin/*, minimum 16 characters. Optional; when unset
# those routes are not registered at all. Leave unset in any public deployment:
# they can trigger settlement sweeps.
ADMIN_TOKEN=
