{
  "name": "@subrosa/backend",
  "version": "0.1.0",
  "private": true,
  "description": "SubRosa Escrow relayer, drand listener, and read API",
  "type": "module",
  "engines": {
    "node": ">=22.7.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-transform-types --no-warnings=ExperimentalWarning src/index.ts",
    "worker": "node --experimental-transform-types --no-warnings=ExperimentalWarning src/worker-main.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "drand:info": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/drand-info.ts",
    "drand:verify": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/verify-beacon.ts",
    "drand:selftest": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/tlock-selftest.ts",
    "e2e": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/e2e.ts",
    "migrate": "node --experimental-transform-types --no-warnings=ExperimentalWarning scripts/migrate.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.1.0",
    "drand-client": "^1.4.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "tlock-js": "^0.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
