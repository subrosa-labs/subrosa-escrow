# SubRosa frontend configuration. Copy to `.env.local`.

# Where the relayer lives.
#
# This one genuinely has to be public: the browser talks to the API directly for reads and
# for the seal flow. Server components use the same value, so a single URL is enough.
NEXT_PUBLIC_SUBROSA_API_URL=http://localhost:8080

# Display symbol for the escrowed asset.
#
# A Soroban contract cannot read a Stellar Asset Contract's metadata, so the contract knows
# the token's address and decimals but not its name. This is presentation only — nothing
# in the protocol depends on it being right.
NEXT_PUBLIC_SETTLEMENT_SYMBOL=USDC
